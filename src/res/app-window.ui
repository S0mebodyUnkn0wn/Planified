<?xml version="1.0" encoding="UTF-8" ?>
<interface>
    <template class="PlanifiedAppWindow" parent="GtkApplicationWindow">
        <child type="titlebar">
            <object class="GtkHeaderBar">
                <child type="start">
                    <object class="GtkStackSwitcher">
                        <property name="stack">view_stack</property>

                    </object>
                </child>
            </object>
        </child>
        <child>
            <object class="GtkStack" id="view_stack">
                <child>
                    <object class="GtkStackPage">
                        <property name="name">home</property>
                        <property name="title">Home</property>
                        <property name="child">
                            <object class="GtkLabel">
                                <property name="label">Placeholder</property>
                            </object>
                        </property>
                    </object>
                </child>
                <child>
                    <object class="GtkStackPage">
                        <property name="name">timetable</property>
                        <property name="title">Timetable</property>
                        <property name="child">
                            <object class="PlanifiedTimetableView">
                            </object>
                        </property>
                    </object>
                </child>
                <child>
                    <object class="GtkStackPage">
                        <property name="name">planning</property>
                        <property name="title">Planning</property>
                        <property name="child">
                            <object class="GtkLabel">
                                <property name="label">Placeholder</property>
                            </object>
                        </property>
                    </object>
                </child>


            </object>
        </child>
    </template>
</interface>